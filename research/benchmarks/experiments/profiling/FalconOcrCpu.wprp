<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="Falcon OCR CPU diagnostics">
  <Profiles>
    <SystemCollector Id="FalconCpuCollector" Name="NT Kernel Logger">
      <BufferSize Value="1024"/>
      <Buffers Value="64"/>
      <MaximumFileSize Value="2048" FileMode="Sequential"/>
    </SystemCollector>
    <SystemCollector Id="FalconCpuMemoryCollector" Name="NT Kernel Logger">
      <BufferSize Value="1024"/>
      <Buffers Value="64"/>
    </SystemCollector>
    <SystemProvider Id="FalconCpuProvider">
      <Keywords>
        <Keyword Value="CpuConfig"/>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="SampledProfile"/>
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile"/>
      </Stacks>
    </SystemProvider>
    <Profile Id="FalconOcrCpu.Verbose.File" Name="FalconOcrCpu"
             Description="Bounded Falcon OCR sampled CPU diagnostic"
             LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="FalconCpuCollector">
          <SystemProviderId Value="FalconCpuProvider"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
    <Profile Id="FalconOcrCpu.Verbose.Memory" Name="FalconOcrCpu"
             Description="Memory variant required by WPR schema; not used by this capture"
             LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="FalconCpuMemoryCollector">
          <SystemProviderId Value="FalconCpuProvider"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
